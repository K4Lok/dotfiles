{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "F24 → fn (globe) key | Keychron has no fn key; set that key to F24 in Keychron Launcher",
                        "manipulators": [
                            {
                                "from": { "key_code": "f24" },
                                "to": [{ "key_code": "fn" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Disable Command + H (stop hiding windows)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "key_code": "vk_none" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock → Hyper Key (⌃⌥⇧⌘) | Escape if alone | Use fn + caps lock to enable caps lock",
                        "manipulators": [
                            {
                                "from": { "key_code": "caps_lock" },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["right_command", "right_option", "right_shift"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
