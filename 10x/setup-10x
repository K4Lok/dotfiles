#!/bin/bash

# Colors for terminal output
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color
YELLOW='\033[1;33m'
BLUE='\033[0;34m'

# Banner
echo -e "${YELLOW}======================================${NC}"
echo -e "${YELLOW}      10x Tools Setup Script          ${NC}"
echo -e "${YELLOW}======================================${NC}"

# Function to check if a dependency is installed
check_dependency() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${RED}✗ $1 is not installed${NC}"
        return 1
    else
        echo -e "${GREEN}✓ $1 is already installed${NC}"
        return 0
    fi
}

# Function to prompt the user for confirmation
confirm() {
    read -p "$1 (y/n) " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]]
}

# Check for Homebrew first, as it's needed for other dependencies
echo -e "\n${BLUE}Checking for Homebrew...${NC}"
if ! command -v brew &> /dev/null; then
    echo -e "${RED}✗ Homebrew is not installed${NC}"
    echo -e "${YELLOW}Homebrew is required to install the other dependencies.${NC}"
    echo -e "${BLUE}You can install Homebrew from: https://brew.sh${NC}"
    echo -e "${BLUE}Run this command to install Homebrew:${NC}"
    echo -e "/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    
    if confirm "Would you like to install Homebrew now?"; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        # Check if Homebrew was installed successfully
        if ! command -v brew &> /dev/null; then
            echo -e "${RED}Failed to install Homebrew. Please install it manually and run this script again.${NC}"
            exit 1
        else
            echo -e "${GREEN}Homebrew installed successfully!${NC}"
        fi
    else
        echo -e "${YELLOW}Setup cannot continue without Homebrew. Exiting.${NC}"
        exit 1
    fi
fi

# Check all required dependencies
echo -e "\n${BLUE}Checking required dependencies...${NC}"
MISSING_DEPS=0
MISSING_DEPS_LIST=""

# Check for yabai
if ! check_dependency "yabai"; then
    MISSING_DEPS_LIST="${MISSING_DEPS_LIST}yabai "
    echo -e "${YELLOW}You can install yabai using: brew install koekeishiya/formulae/yabai${NC}"
    echo -e "${BLUE}Documentation: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)${NC}"
    echo -e "${YELLOW}Note: Some advanced features require disabling SIP. See the documentation for details.${NC}"
    ((MISSING_DEPS++))
fi

# Check for skhd
if ! check_dependency "skhd"; then
    MISSING_DEPS_LIST="${MISSING_DEPS_LIST}skhd "
    echo -e "${YELLOW}You can install skhd using: brew install koekeishiya/formulae/skhd${NC}"
    echo -e "${BLUE}Documentation: https://github.com/koekeishiya/skhd${NC}"
    ((MISSING_DEPS++))
fi

# Check for borders
if ! check_dependency "borders"; then
    MISSING_DEPS_LIST="${MISSING_DEPS_LIST}borders "
    echo -e "${YELLOW}You can install borders using: brew install FelixKratz/formulae/borders${NC}"
    echo -e "${BLUE}Documentation: https://github.com/FelixKratz/JankyBorders${NC}"
    ((MISSING_DEPS++))
fi

# Check for Karabiner-Elements
if ! [ -d "/Applications/Karabiner-Elements.app" ]; then
    MISSING_DEPS_LIST="${MISSING_DEPS_LIST}karabiner-elements "
    echo -e "${RED}✗ Karabiner-Elements is not installed${NC}"
    echo -e "${YELLOW}You can install it using: brew install --cask karabiner-elements${NC}"
    echo -e "${BLUE}Documentation: https://karabiner-elements.pqrs.org/docs/getting-started/installation/${NC}"
    ((MISSING_DEPS++))
else
    echo -e "${GREEN}✓ Karabiner-Elements is already installed${NC}"
fi

# Offer to install missing dependencies
if [ $MISSING_DEPS -gt 0 ]; then
    echo -e "\n${YELLOW}Missing dependencies: ${MISSING_DEPS_LIST}${NC}"
    
    if confirm "Would you like to install the missing dependencies now?"; then
        # Install missing dependencies
        if [[ $MISSING_DEPS_LIST == *"yabai"* ]]; then
            echo -e "${BLUE}Installing yabai...${NC}"
            brew install koekeishiya/formulae/yabai
        fi
        
        if [[ $MISSING_DEPS_LIST == *"skhd"* ]]; then
            echo -e "${BLUE}Installing skhd...${NC}"
            brew install koekeishiya/formulae/skhd
        fi
        
        if [[ $MISSING_DEPS_LIST == *"borders"* ]]; then
            echo -e "${BLUE}Installing borders...${NC}"
            brew install FelixKratz/formulae/borders
        fi
        
        if [[ $MISSING_DEPS_LIST == *"karabiner-elements"* ]]; then
            echo -e "${BLUE}Installing Karabiner-Elements...${NC}"
            brew install --cask karabiner-elements
        fi
        
        # Re-check dependencies
        echo -e "\n${BLUE}Verifying installations...${NC}"
        MISSING_DEPS=0
        
        # Only re-check the ones that were missing
        if [[ $MISSING_DEPS_LIST == *"yabai"* ]] && ! check_dependency "yabai"; then
            ((MISSING_DEPS++))
        fi
        
        if [[ $MISSING_DEPS_LIST == *"skhd"* ]] && ! check_dependency "skhd"; then
            ((MISSING_DEPS++))
        fi
        
        if [[ $MISSING_DEPS_LIST == *"borders"* ]] && ! check_dependency "borders"; then
            ((MISSING_DEPS++))
        fi
        
        if [[ $MISSING_DEPS_LIST == *"karabiner-elements"* ]] && ! [ -d "/Applications/Karabiner-Elements.app" ]; then
            echo -e "${RED}✗ Karabiner-Elements installation failed${NC}"
            ((MISSING_DEPS++))
        elif [[ $MISSING_DEPS_LIST == *"karabiner-elements"* ]]; then
            echo -e "${GREEN}✓ Karabiner-Elements is now installed${NC}"
        fi
    fi
    
    # If there are still missing dependencies, ask if user wants to continue anyway
    if [ $MISSING_DEPS -gt 0 ]; then
        echo -e "\n${YELLOW}There are still missing dependencies.${NC}"
        if ! confirm "Do you want to continue with setup anyway?"; then
            echo -e "${YELLOW}Setup aborted. Please install all dependencies and run this script again.${NC}"
            exit 1
        fi
    fi
fi

# Continue with setup now that dependencies are checked
echo -e "\n${BLUE}Setting up 10x tools...${NC}"

# Create necessary directories
echo -e "${BLUE}Creating necessary directories...${NC}"
mkdir -p ~/.local/bin
mkdir -p ~/.config/10x/karabiner_profiles
mkdir -p ~/.config/karabiner

# Create empty Karabiner profile
echo -e "${BLUE}Creating empty Karabiner profile...${NC}"
cat > ~/.config/10x/karabiner_profiles/empty_profile.json << 'EOL'
{
    "global": {
        "check_for_updates_on_startup": true,
        "show_in_menu_bar": true,
        "show_profile_name_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "Empty",
            "selected": true,
            "simple_modifications": [],
            "complex_modifications": {
                "parameters": {
                    "basic.simultaneous_threshold_milliseconds": 50,
                    "basic.to_delayed_action_delay_milliseconds": 500,
                    "basic.to_if_alone_timeout_milliseconds": 1000,
                    "basic.to_if_held_down_threshold_milliseconds": 500,
                    "mouse_motion_to_scroll.speed": 100
                },
                "rules": []
            }
        }
    ]
}
EOL

# Backup current Karabiner config if it exists
if [ -f ~/.config/karabiner/karabiner.json ]; then
    echo -e "${BLUE}Backing up current Karabiner configuration...${NC}"
    # Backup to karabiner config folder
    cp ~/.config/karabiner/karabiner.json ~/.config/karabiner/backup_karabiner.json
    # Backup to 10x profiles folder
    cp ~/.config/karabiner/karabiner.json ~/.config/10x/karabiner_profiles/custom_profile.json
    echo -e "${GREEN}Karabiner configuration backed up successfully to ~/.config/10x/karabiner_profiles/custom_profile.json${NC}"
fi

# Install 10x script by copying from the source
echo -e "${BLUE}Installing 10x command...${NC}"
cp "$(dirname "$0")/10x" ~/.local/bin/10x
chmod +x ~/.local/bin/10x
echo -e "${GREEN}10x command installed to ~/.local/bin/10x${NC}"

# Check if PATH includes ~/.local/bin
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    echo -e "${BLUE}Adding ~/.local/bin to PATH...${NC}"
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
    echo -e "${GREEN}Added ~/.local/bin to PATH in .zshrc${NC}"
else
    echo -e "${GREEN}~/.local/bin is already in PATH${NC}"
fi

# Setup complete
echo -e "\n${GREEN}Setup completed successfully!${NC}"
echo -e "\n${BLUE}You can use the following commands:${NC}"
echo -e "${YELLOW}10x${NC}     - Show current status"
echo -e "${YELLOW}10x on${NC}  - Enable all tools"
echo -e "${YELLOW}10x off${NC} - Disable all tools"
echo -e "\n${BLUE}Please restart your terminal or run:${NC} source ~/.zshrc"

# Check if there are any permissions that might need to be set up
echo -e "\n${YELLOW}Remember to grant accessibility permissions for:${NC}"
echo -e "- yabai"
echo -e "- skhd"
echo -e "- karabiner-elements"
echo -e "\n${BLUE}Open Privacy & Security settings?${NC}"
if confirm "Open System Settings now?"; then
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
fi

# Reference
# Karabiner
# Switching profile https://github.com/pqrs-org/Karabiner-Elements/issues/2649
