#!/bin/bash

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color
YELLOW='\033[1;33m'

echo -e "${YELLOW}Setting up 10x tools control...${NC}"

# Create necessary directories
mkdir -p ~/.local/bin
mkdir -p ~/.config/10x/karabiner_profiles
mkdir -p ~/.config/karabiner

# Create empty Karabiner profile
cat > ~/.config/10x/karabiner_profiles/empty_profile.json << 'EOL'
{
    "global": {
        "check_for_updates_on_startup": true,
        "show_in_menu_bar": true,
        "show_profile_name_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "Empty",
            "selected": true,
            "simple_modifications": [],
            "complex_modifications": {
                "parameters": {
                    "basic.simultaneous_threshold_milliseconds": 50,
                    "basic.to_delayed_action_delay_milliseconds": 500,
                    "basic.to_if_alone_timeout_milliseconds": 1000,
                    "basic.to_if_held_down_threshold_milliseconds": 500,
                    "mouse_motion_to_scroll.speed": 100
                },
                "rules": []
            }
        }
    ]
}
EOL

# Backup current Karabiner config if it exists
if [ -f ~/.config/karabiner/karabiner.json ]; then
    echo -e "${YELLOW}Backing up current Karabiner configuration...${NC}"
    # Backup to karabiner config folder
    cp ~/.config/karabiner/karabiner.json ~/.config/karabiner/backup_karabiner.json
    # Backup to 10x profiles folder
    cp ~/.config/karabiner/karabiner.json ~/.config/10x/karabiner_profiles/custom_profile.json
fi

# Install 10x script by copying from the source
cp "$(dirname "$0")/10x" ~/.local/bin/10x
chmod +x ~/.local/bin/10x

# Check if PATH includes ~/.local/bin
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
    echo -e "${YELLOW}Added ~/.local/bin to PATH in .zshrc${NC}"
fi

# Check for required applications
check_dependency() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${RED}$1 is not installed${NC}"
        echo -e "${YELLOW}You can install it using: brew install $1${NC}"
        return 1
    else
        echo -e "${GREEN}$1 is already installed${NC}"
        return 0
    fi
}

# Check for Homebrew
if ! command -v brew &> /dev/null; then
    echo -e "${RED}Homebrew is not installed${NC}"
    echo -e "${YELLOW}You can install it from: https://brew.sh${NC}"
fi

# Check required packages
MISSING_DEPS=0
check_dependency "yabai" || ((MISSING_DEPS++))
check_dependency "skhd" || ((MISSING_DEPS++))
check_dependency "borders" || ((MISSING_DEPS++))

# Check for Karabiner-Elements
if ! [ -d "/Applications/Karabiner-Elements.app" ]; then
    echo -e "${RED}Karabiner-Elements is not installed${NC}"
    echo -e "${YELLOW}You can install it using: brew install --cask karabiner-elements${NC}"
    ((MISSING_DEPS++))
else
    echo -e "${GREEN}Karabiner-Elements is already installed${NC}"
fi

echo -e "\n${GREEN}Setup complete!${NC}"
if [ $MISSING_DEPS -gt 0 ]; then
    echo -e "${YELLOW}Please install the missing dependencies before using 10x${NC}"
fi

echo -e "\nAfter installing dependencies, you can use the following commands:"
echo -e "${YELLOW}10x${NC} - Show current status"
echo -e "${YELLOW}10x on${NC} - Enable all tools"
echo -e "${YELLOW}10x off${NC} - Disable all tools"
echo -e "\nPlease restart your terminal or run: source ~/.zshrc"