#!/bin/bash

CONFIG_FILE="$HOME/.config/10x/status"
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color
YELLOW='\033[1;33m'

check_service_status() {
    local service=$1
    if pgrep -x "$service" >/dev/null; then
        echo -e "${GREEN}✓${NC} $service is running"
        return 0
    else
        echo -e "${RED}✗${NC} $service is not running"
        return 1
    fi
}

check_karabiner_profile() {
    local current_profile="$HOME/.config/karabiner/karabiner.json"
    local empty_profile="$HOME/.config/10x/karabiner_profiles/empty_profile.json"
    local custom_profile="$HOME/.config/10x/karabiner_profiles/custom_profile.json"
    
    if [ ! -f "$current_profile" ]; then
        echo -e "${RED}✗${NC} karabiner profile not found"
        return 1
    fi
    
    # Compare with empty profile
    if diff "$current_profile" "$empty_profile" >/dev/null 2>&1; then
        echo -e "${RED}✗${NC} karabiner is using empty profile"
        return 1
    else
        echo -e "${GREEN}✓${NC} karabiner is using custom profile"
        return 0
    fi
}

status() {
    echo "=== 10x Tools Status ==="
    if [ "$(cat "$CONFIG_FILE")" = "enabled" ]; then
        echo -e "${GREEN}10x mode is active${NC}"
    else
        echo -e "${RED}10x mode is inactive${NC}"
    fi
    
    echo "Services status:"
    check_service_status "yabai"
    check_service_status "skhd"
    check_karabiner_profile
}

enable_10x() {
    echo "enabled" > "$CONFIG_FILE"
    echo -e "${YELLOW}Enabling 10x mode...${NC}"
    
    # Start yabai
    yabai --start-service
    # Start skhd
    skhd --start-service
    # Switch to custom Karabiner profile
    if [ -f "$HOME/.config/10x/karabiner_profiles/custom_profile.json" ]; then
        cp "$HOME/.config/10x/karabiner_profiles/custom_profile.json" "$HOME/.config/karabiner/karabiner.json"
    elif [ -f "$HOME/.config/karabiner/backup_karabiner.json" ]; then
        echo -e "${YELLOW}Using backup Karabiner configuration...${NC}"
        cp "$HOME/.config/karabiner/backup_karabiner.json" "$HOME/.config/karabiner/karabiner.json"
        # Also restore the custom profile
        cp "$HOME/.config/karabiner/backup_karabiner.json" "$HOME/.config/10x/karabiner_profiles/custom_profile.json"
    else
        echo -e "${RED}No custom Karabiner profile found${NC}"
    fi
    # Start borders (disabled)
    # borders active_color="0xff494d64" inactive_color="0xffe1e3e4" width=5.0 &
    
    echo -e "${GREEN}10x mode has been enabled${NC}"
    status
}

disable_10x() {
    echo "disabled" > "$CONFIG_FILE"
    echo -e "${YELLOW}Disabling 10x mode...${NC}"
    
    # Stop yabai
    yabai --stop-service
    # Stop skhd
    skhd --stop-service
    # Switch to empty Karabiner profile
    cp "$HOME/.config/10x/karabiner_profiles/empty_profile.json" "$HOME/.config/karabiner/karabiner.json"
    # Kill borders
    pkill borders
    
    echo -e "${GREEN}10x mode has been disabled${NC}"
    status
}

# Create config directory and file if they don't exist
mkdir -p "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "disabled" > "$CONFIG_FILE"
fi

case "$1" in
    "on")
        enable_10x
        ;;
    "off")
        disable_10x
        ;;
    *)
        status
        ;;
esac
