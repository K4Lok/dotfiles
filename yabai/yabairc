# ====== Signal ===============================
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Discord (Electron) often wins the race against its own accessibility tree and
# ends up with has-ax-reference=false — yabai can see the window but can't tile,
# move, or float-toggle it. The script restarts yabai only if that actually
# happened. It also fires on Discord's frequent self-update relaunch.
yabai -m signal --add label="Discord AX repair" event=application_launched app="^Discord$" \
  action="~/dotfiles/yabai/scripts/ax-repair.sh '^Discord$' &"

# ====== Variables ============================

gap_top="6"
gap_bottom="6"
gap_left="6"
gap_right="6"
gap_inner="8"

focused_color="0xff494d64"
normal_color="0xffe1e3e4"

# ===== Tiling setting =========================

yabai -m config layout                      bsp

yabai -m config top_padding                 ${gap_top}
yabai -m config bottom_padding              ${gap_bottom}
yabai -m config left_padding                ${gap_left}
yabai -m config right_padding               ${gap_right}
yabai -m config window_gap                  ${gap_inner}

# ===== Rules ==================================

yabai -m rule --add label="Finder" app="^Finder$" manage=off
yabai -m rule --add label="System Settings" app="^System Settings$" manage=off
yabai -m rule --add label="Activity Monitor" app="^Activity Monitor$" manage=off
yabai -m rule --add label="Calculator" app="^Calculator$" manage=off
yabai -m rule --add label="iPhone Mirroring" app="^iPhone Mirroring$" manage=off

# yabai -m rule --add label="Docker Desktop" app="^Docker Desktop$" manage=off
yabai -m rule --add label="WhatsApp" app="^WhatsApp$" manage=off
yabai -m rule --add label="WeChat" app="^WeChat$" manage=off
yabai -m rule --add label="CleanShot X" app="^CleanShot X$" manage=off
yabai -m rule --add label="Screen Studio" app="^Screen Studio$" manage=off
yabai -m rule --add label="Perplexity Voice Mode" app="^Perplexity$" title="^Perplexity Voice Mode$" manage=off
yabai -m rule --add label="Simulator" app="^Simulator$" manage=off
yabai -m rule --add label="Typeless" app="^Typeless$" manage=off

